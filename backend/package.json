{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "description": "Wireup API — Express + MongoDB, routes/controllers/models/services",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.mjs"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "mongoose": "^9.9.4",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "uuid": "^14.0.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.3.3",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.12",
    "typescript": "~5.9.3"
  }
}