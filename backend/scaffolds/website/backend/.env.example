# ── Server ────────────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=development

# Comma-separated allowed browser origins (the SPA's address in dev).
CORS_ORIGIN=http://localhost:5173

# ── Device connection (set to your device's real address) ────────────────
# The backend reaches the device over your local network. Same Wi-Fi required
# for LAN access; set a public/tunnel host if the device is exposed.
DEVICE_IP=192.168.1.100
DEVICE_PORT=8081
DEVICE_PROTOCOL=http

# JSON string overriding the endpoints defined in
# backend/src/config/deviceEndpoints.ts. Optional — leave empty to use code.
DEVICE_ENDPOINTS_JSON=

# ── Persistence (optional) ────────────────────────────────────────────────
# If empty, history is kept in-memory (resets on restart). Add a real Mongo
# URI (local or Atlas) to persist readings.
MONGO_URI=

# How long live requests wait on the device before timing out (ms).
DEVICE_TIMEOUT_MS=4000
