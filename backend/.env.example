# ── LLM Provider Configuration ───────────────────────────────────────────────
# Choose provider: 'groq' or 'bedrock'
LLM_PROVIDER=groq

# Groq settings (used when LLM_PROVIDER=groq)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# AWS Bedrock settings (used when LLM_PROVIDER=bedrock).
# You can set explicit keys below, or leave them blank and let the AWS SDK use
# its normal credential chain (AWS_PROFILE, ~/.aws/credentials, IAM role,
# ECS/EC2 metadata, etc.).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_REGION=us-east-1
# Optional: point Bedrock at a local mock or VPC endpoint.
# BEDROCK_ENDPOINT=https://bedrock-runtime.us-east-1.amazonaws.com
# BEDROCK_MODEL=moonshotai.kimi-k2.5

# Optional. Without it the API still runs — it just does not persist projects.
MONGO_URI=

# Optional overrides.
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Rate limits guarding the paid endpoints.
PLAN_RATE_LIMIT_MAX=10
PLAN_RATE_LIMIT_WINDOW_MS=60000
RENDER_RATE_LIMIT_MAX=20
RENDER_RATE_LIMIT_WINDOW_MS=60000
MAX_REVISIONS=25

# Image generation (Cloudflare). Leave blank to disable rendering.
IMAGE_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ── Wireup Auth ──────────────────────────────────────────────────────────────
# Secret for signing session tokens. Change this anywhere shared.
JWT_SECRET=wireup-dev-secret-change-me
AUTH_TOKEN_TTL_SECONDS=604800
# File user store (used when MONGO_URI is unset).
AUTH_DB_PATH=.data/users.json

# ── Agentic pipeline ─────────────────────────────────────────────────────────
AGENTIC_MAX_REPAIR_LOOPS=3
AGENTIC_COMMAND_TIMEOUT_MS=240000
AGENTIC_WORKDIR=/tmp/wireup-agentic
AGENTIC_TERMINAL_VALIDATION=1
# Runtime boot smoke test for the generated MERN app (1=on).
AGENTIC_SMOKE_TEST=1
# Real embedded compile to an ESP32 binary with PlatformIO (preferred) or
# arduino-cli. Auto-skips when the tool is not installed; set to 0 to disable.
AGENTIC_EMBEDDED_COMPILE=1
# Boot the compiled firmware in the Wokwi headless simulator (virtual circuit
# generated from the build plan). Needs wokwi-cli + the token below; auto-skips.
AGENTIC_WOKWI=1
# Free CI token from https://wokwi.com/dashboard/ci (required for wokwi-cli).
WOKWI_CLI_TOKEN=
