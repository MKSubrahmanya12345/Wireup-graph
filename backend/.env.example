# ── LLM Provider Configuration ───────────────────────────────────────────────
# Choose provider: 'groq' | 'bedrock' | 'gemini'
# NOTE: the agentic build picks its provider from the USER'S PLAN (free→Groq,
# pro→Gemini), not from this value. This is only the default for other calls.
LLM_PROVIDER=groq

# Google Gemini — the Pro tier's model. Leave blank and Pro-tier builds log a
# warning and fall back to Groq (never a silent downgrade, never a crash).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Groq settings (used when LLM_PROVIDER=groq)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# AWS Bedrock settings (used when LLM_PROVIDER=bedrock).
# You can set explicit keys below, or leave them blank and let the AWS SDK use
# its normal credential chain (AWS_PROFILE, ~/.aws/credentials, IAM role,
# ECS/EC2 metadata, etc.).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_REGION=us-east-1
# Optional: point Bedrock at a local mock or VPC endpoint.
# BEDROCK_ENDPOINT=https://bedrock-runtime.us-east-1.amazonaws.com
# BEDROCK_MODEL=moonshotai.kimi-k2.5

# Optional. Without it the API still runs — it just does not persist projects.
MONGO_URI=

# Optional overrides.
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Rate limits guarding the paid endpoints.
PLAN_RATE_LIMIT_MAX=10
PLAN_RATE_LIMIT_WINDOW_MS=60000
RENDER_RATE_LIMIT_MAX=20
RENDER_RATE_LIMIT_WINDOW_MS=60000
MAX_REVISIONS=25

# Image generation (Cloudflare). Leave blank to disable rendering.
IMAGE_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ── Wireup Auth ──────────────────────────────────────────────────────────────
# Secret for signing session tokens. Change this anywhere shared.
JWT_SECRET=wireup-dev-secret-change-me
AUTH_TOKEN_TTL_SECONDS=604800
# File user store (used when MONGO_URI is unset).
AUTH_DB_PATH=.data/users.json

# ── Agentic pipeline ─────────────────────────────────────────────────────────
AGENTIC_MAX_REPAIR_LOOPS=3
AGENTIC_COMMAND_TIMEOUT_MS=240000
AGENTIC_WORKDIR=/tmp/wireup-agentic
AGENTIC_TERMINAL_VALIDATION=1
# Runtime boot smoke test for the generated MERN app (1=on).
AGENTIC_SMOKE_TEST=1
# Real embedded compile to an ESP32 binary with PlatformIO (preferred) or
# arduino-cli. Auto-skips when the tool is not installed; set to 0 to disable.
AGENTIC_EMBEDDED_COMPILE=1
# Boot the compiled firmware in the Wokwi headless simulator (virtual circuit
# generated from the build plan). Needs wokwi-cli + the token below; auto-skips.
AGENTIC_WOKWI=1
# Free CI token from https://wokwi.com/dashboard/ci (required for wokwi-cli).
WOKWI_CLI_TOKEN=

# ── Payments (M0/M1) ─────────────────────────────────────────────────────────
# auto = razorpay when the keys below exist, mock otherwise.
# mock = MockPaymentProvider: the fake checkout self-fires its own webhook, so
#        the whole billing loop is provable with zero credentials.
PAYMENT_MODE=auto
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Where the mock self-fires its webhook (and where real callbacks land).
APP_BASE_URL=http://localhost:5000
# How long the fake hosted checkout "takes" before the webhook fires.
MOCK_PAYMENT_DELAY_MS=1200

# ── Hardware simulation (M0/M4) ──────────────────────────────────────────────
# auto = velxio when VELXIO_URL is set, mock otherwise.
SIM_MODE=auto
# Velxio endpoint (https://github.com/davidmonterocrespo24/velxio — vendored as
# the external/velxio submodule, AGPL-3.0). Two uses, one variable:
#   • SIM_MODE=velxio  → the readiness gate posts the plan to {VELXIO_URL}/simulate
#   • page 04 (/sim)   → embeds this URL instead of the built-in browser bench
# Self-host it with:  docker compose -f external/velxio/docker-compose.yml up -d
VELXIO_URL=
VELXIO_API_KEY=
VELXIO_TIMEOUT_MS=120000
# Test hooks for the download gate: force the simulated hardware to fail, or
# force the provider itself to error (a different, explicitly surfaced state).
# SIM_FORCE_FAIL=1
# SIM_FORCE_ERROR=1

# ── Live dashboard preview (page 04, "Website" half) ─────────────────────────
# Where the generated dashboard bundles are kept after the software gate builds
# them. Default: <tmp>/wireup-previews. Only the newest 8 builds are retained.
PREVIEW_DIR=

# ── Billing store + admin seed (M1) ──────────────────────────────────────────
# File-backed billing store (used when MONGO_URI is unset).
BILLING_DB_PATH=.data/billing.json
ADMIN_EMAIL=admin@wireup.local
ADMIN_NAME=Wireup Admin
# CHANGE THIS anywhere that is not a laptop.
ADMIN_PASSWORD=wireup-admin-dev
# Set to 0 to skip admin seeding entirely.
ADMIN_SEED=1

# ── BOM affiliate tags (M5) ──────────────────────────────────────────────────
# Optional. Without a tag the plain product link is rendered.
AFFILIATE_TAG_AMAZON=
AFFILIATE_TAG_ROBU=
AFFILIATE_TAG_DIGIKEY=
